# 可选：等你有了域名再套这一层。没域名前直接开 IP:8080 也能用。
#
#   sudo cp nginx.conf.example /etc/nginx/sites-available/shenyan-demo
#   sudo ln -s /etc/nginx/sites-available/shenyan-demo /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# 再跑一次 certbot --nginx -d demo.example.com 就有 HTTPS 了。

server {
    listen 80;
    server_name demo.example.com;

    # 演示页就一个 HTML，不缓存最省心
    add_header Cache-Control "no-store";

    client_max_body_size 8k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 一次回复最多 90 秒，别让 nginx 先断
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}
