# 复制为 .env.shenyan；不要把真实密钥发送给别人或上传到公共仓库。
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_REAL_KEY
# 在 AstrBot 的 OpenAI Compatible 提供商中填同一个值（不是 DeepSeek 的 Key）。
GATEWAY_KEY=CHANGE_ME_TO_A_RANDOM_LONG_SECRET
# 2026-10-30 当前官方支持 deepseek-flash / deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-flash
EXTRACT_EVERY=5
RECENT_TURNS=10

# ── 世界事件（MCP）─────────────────────────────────────────
# 表情素材目录，compose 里挂在 /app/assets
ASSETS_DIR=/app/assets
# 每轮注入哪些 MCP 工具的结果。格式 server.tool,用逗号分隔。
# 关掉世界感知就把它留空。
WORLD_CONTEXT_TOOLS=clock.now,weather.now
# 情境缓存秒数。天气这类信息没必要每句话都重新拉。
WORLD_CACHE_TTL=600
WORLD_TZ=Asia/Singapore
# 换新闻源就改这里（要 RSS）。
# WORLD_NEWS_FEED=https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml
# 接外部 MCP server：JSON 数组，command 是启动命令。
# MCP_SERVERS=[{"name":"shenyan-world","command":["python","world_server.py"]}]

# ── 网页演示（可选，见 web-demo/README.md）──────────────────
# 打开后，带 X-Demo-Session 头的请求各自用 /data/sessions/<sid>.sqlite3，
# 不读、不写、也删不掉主人这份 shenyan.sqlite3。
DEMO_MODE=1
# 演示会话的抽提间隔：聊两轮就出候选。
DEMO_EXTRACT_EVERY=2
# 演示库闲置多久回收（小时）。
SESSION_TTL_HOURS=3
# 邀请码。留空 = 谁拿到链接都能聊，只适合本机试。
DEMO_PASSCODE=
# 三层限流：单会话 / 单 IP / 全站每天的条数（都在 10 分钟窗口内算，日额度除外）。
SESSION_LIMIT=30
IP_LIMIT=60
DAILY_LIMIT=600
